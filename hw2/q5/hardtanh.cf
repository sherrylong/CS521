def Shape as (Float l, Float u, PolyExp L, PolyExp U){[(curr[l]<=curr),(curr[u]>=curr),(curr[L]<=curr),(curr[U]>=curr)]};

func simplify_lower(Neuron n, Float coeff) = (coeff >= 0.0) ? (coeff * n[l]) : (coeff * n[u]);
func simplify_upper(Neuron n, Float coeff) = (coeff >= 0.0) ? (coeff * n[u]) : (coeff * n[l]);

func replace_lower(Neuron n, Float coeff) = (coeff >= 0.0) ? (coeff * n[L]) : (coeff * n[U]);
func replace_upper(Neuron n, Float coeff) = (coeff >= 0.0) ? (coeff * n[U]) : (coeff * n[L]);

func priority(Neuron n) = n[layer];
func priority2(Neuron n, Float c) = -n[layer];
func stop(Neuron n) = false;
func stop_traverse(Neuron n, Float c) = false;

func backsubs_lower(PolyExp e, Neuron n) = (e.traverse(backward, priority2, stop_traverse, replace_lower){e <= n}).map(simplify_lower);
func backsubs_upper(PolyExp e, Neuron n) = (e.traverse(backward, priority2, stop_traverse, replace_upper){e >= n}).map(simplify_upper);

func relu(Float x) = x >= 0.0 ? x : 0.0;
func relu_lower(Neuron n) = n[l] + n[u] >= 0.0 ? n : 0.0;
func relu_upper(Neuron n) = n[l] >= 0.0 ? n : (n[u] <= 0.0 ? 0.0 : (((n[u]) / ((n[u]) - (n[l]))) * n) - (((n[u]) * (n[l])) / ((n[u]) - (n[l]))));

func hardtanh(Float x) = x <= (0.0 - 1.0) ? (0.0 - 1.0) : (x >= 1.0 ? 1.0 : x);

func hardtanh_case1(Float lower, Float upper) = upper <= (0.0 - 1.0); 
func hardtanh_case2(Float lower, Float upper) = lower >= 1.0; 
func hardtanh_case3(Float lower, Float upper) = (lower >= (0.0 - 1.0)) and (upper <= 1.0); 
func hardtanh_case4(Float lower, Float upper) = ((lower < (0.0 - 1.0)) and (upper > (0.0 - 1.0))) and (upper <= 1.0);
func hardtanh_case5(Float lower, Float upper) = ((lower >= (0.0 - 1.0)) and (lower < 1.0)) and (upper > 1.0);
func hardtanh_case6(Float lower, Float upper) = (lower < (0.0 - 1.0)) and (upper > 1.0);

func hardtanh_lower_slope(Float lower, Float upper) =
    hardtanh_case1(lower, upper) ? 0.0 :
    (hardtanh_case2(lower, upper) ? 0.0 :
    (hardtanh_case3(lower, upper) ? 1.0 :
    (hardtanh_case4(lower, upper) ? 0.0 :
    (lower >= (0.0 - 1.0) ? (1.0 - lower) / (upper - lower) :
    2.0 / (upper + 1.0)))));

func hardtanh_lower_intercept(Float lower, Float upper) =
    hardtanh_case1(lower, upper) ? (0.0 - 1.0) :
    (hardtanh_case2(lower, upper) ? 1.0 :
    (hardtanh_case3(lower, upper) ? 0.0 :
    (hardtanh_case4(lower, upper) ? (0.0 - 1.0) :
    (lower >= (0.0 - 1.0) ? lower - (((1.0 - lower) / (upper - lower)) * lower) :
    (2.0 / (upper + 1.0)) - 1.0))));

func hardtanh_lower(Neuron n) = hardtanh_lower_slope(n[l], n[u]) * n + hardtanh_lower_intercept(n[l], n[u]);

func hardtanh_upper_slope(Float lower, Float upper) =
    hardtanh_case1(lower, upper) ? 0.0 :
    (hardtanh_case2(lower, upper) ? 0.0 :
    (hardtanh_case3(lower, upper) ? 1.0 :
    (hardtanh_case4(lower, upper) ? (upper + 1.0) / (upper - lower) :
    (lower >= (0.0 - 1.0) ? 0.0 : 2.0 / (1.0 - lower)))));

func hardtanh_upper_intercept(Float lower, Float upper) =
    hardtanh_case1(lower, upper) ? (0.0 - 1.0) :
    (hardtanh_case2(lower, upper) ? 1.0 :
    (hardtanh_case3(lower, upper) ? 0.0 :
    (hardtanh_case4(lower, upper) ? (0.0 - 1.0) - (((upper + 1.0) / (upper - lower)) * lower) :
    (lower >= (0.0 - 1.0) ? 1.0 : 1.0 - (2.0 / (1.0 - lower))))));

func hardtanh_upper(Neuron n) = hardtanh_upper_slope(n[l], n[u]) * n + hardtanh_upper_intercept(n[l], n[u]);

transformer deeppoly {
    Affine -> (backsubs_lower(prev.dot(curr[weight]) + curr[bias], curr),
               backsubs_upper(prev.dot(curr[weight]) + curr[bias], curr),
               prev.dot(curr[weight]) + curr[bias],
               prev.dot(curr[weight]) + curr[bias]);
    Relu -> (relu(prev[l]), relu(prev[u]), relu_lower(prev), relu_upper(prev));
    HardTanh -> (hardtanh(prev[l]), hardtanh(prev[u]), hardtanh_lower(prev), hardtanh_upper(prev));
}

flow(forward, priority, stop, deeppoly);
